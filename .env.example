# 将此模板复制为 .env 后填写；真实凭据只保存到 .env。
# 标记说明：【必填】替换占位值；【默认可用】通常保留；【按需修改】随部署环境调整。

# App config
# 【默认可用】配置名称。
MINDMEMOS_CONFIG_NAME=dev
# 【Lite 部署必填】填写 config/mindmemos_lite/dev.yaml。
MINDMEMOS_CONFIG_PATH=

# MindMemOS Lite API
# 【默认可用】监听全部网卡；仅本机访问时改为 127.0.0.1。
MINDMEMOS_API_HOST=0.0.0.0
# 【默认可用】端口冲突时修改；调用接口时使用此端口。
MINDMEMOS_API_PORT=8000
# 【默认可用】按部署说明创建该文件；自定义文件位置时修改。
MINDMEMOS_API_KEY_FILE=config/mindmemos_lite/api_keys.yaml

# MindMemOS Lite PostgreSQL + pgvector
# Docker 在首次启动空数据卷时初始化以下数据库、账号和密码。
# 【默认可用】数据库名。
PGVECTOR_DATABASE=mindmemos
# 【默认可用】数据库账号。
PGVECTOR_USER=mindmemos_user
# 【必填】设置实际数据库密码，并同步下方 PGVECTOR_DSN。
PGVECTOR_PASSWORD=replace-password
# 【默认可用】数据库宿主机端口；端口冲突时修改，并同步 PGVECTOR_DSN。
PGVECTOR_PORT=5432
# 【必填】替换密码，账号、端口和数据库名与上方保持一致；密码中的 URI 特殊字符需编码。
# 【按需修改】使用已有或远程数据库时，填写其实际连接串。
PGVECTOR_DSN=postgresql://mindmemos_user:replace-password@127.0.0.1:5432/mindmemos
# 【默认可用】数据库内的命名空间。
PGVECTOR_SCHEMA=mindmemos

# MindMemOS Lite models (used by the deployment guide YAML)
# 【必填确认】实际 LLM 模型名；仅服务提供此模型时保留示例值。
MINDMEMOS_LLM_MODEL=openai/gpt-4.1-mini
# 【必填】实际 LLM 服务基础地址。
MINDMEMOS_LLM_BASE_URL=https://your-llm-endpoint/v1
# 【必填】实际 LLM 服务密钥。
MINDMEMOS_LLM_API_KEY=replace-llm-key
# 【必填确认】实际 Embedding 模型名；同时核对 config 中的输出维度。
MINDMEMOS_EMBED_MODEL=openai/qwen3-embedding-4b
# 【必填】实际 Embedding 服务基础地址。
MINDMEMOS_EMBED_BASE_URL=https://your-embedding-endpoint/v1
# 【必填】实际 Embedding 服务密钥。
MINDMEMOS_EMBED_API_KEY=replace-embedding-key

# 以下为主服务及评测组件配置；本文 Lite 部署方案无需填写或修改。
# Qdrant
MINDMEMOS_QDRANT_URL=http://localhost:6333
MINDMEMOS_QDRANT_HTTP_PORT=6333
MINDMEMOS_QDRANT_GRPC_PORT=6334
MINDMEMOS_QDRANT_PREFER_GRPC=true
MINDMEMOS_QDRANT_API_KEY=
MINDMEMOS_GRAFANA_QDRANT_URL=http://qdrant:6333

# Neo4j
MINDMEMOS_NEO4J_URI=bolt://localhost:7687
MINDMEMOS_NEO4J_HTTP_PORT=7474
MINDMEMOS_NEO4J_BOLT_PORT=7687
MINDMEMOS_NEO4J_USERNAME=neo4j
MINDMEMOS_NEO4J_PASSWORD=

# Kafka
MINDMEMOS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MINDMEMOS_KAFKA_PORT=9092
MINDMEMOS_KAFKA_UI_PORT=8080
MINDMEMOS_KAFKA_EXPORTER_PORT=9308

# Observability
MINDMEMOS_TELEMETRY_ENDPOINT=http://localhost:4318
MINDMEMOS_OTEL_GRPC_ENDPOINT=0.0.0.0:4317
MINDMEMOS_OTEL_HTTP_ENDPOINT=0.0.0.0:4318
MINDMEMOS_OTEL_KAFKA_EXPORTER_TARGET=kafka-exporter:9308
MINDMEMOS_OTEL_CLICKHOUSE_ENDPOINT=tcp://clickhouse:9000?dial_timeout=10s
MINDMEMOS_OTEL_HTTP_PORT=4318
MINDMEMOS_OTEL_GRPC_PORT=4317
MINDMEMOS_GRAFANA_PORT=3000

# Eval metrics collector
MINDMEMOS_CLICKHOUSE_HTTP_PORT=8123
MINDMEMOS_CLICKHOUSE_NATIVE_PORT=9000
MINDMEMOS_CLICKHOUSE_DB=otel
MINDMEMOS_CLICKHOUSE_USER=mindmemos
MINDMEMOS_CLICKHOUSE_PASSWORD=
