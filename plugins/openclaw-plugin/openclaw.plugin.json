{
  "id": "mindmemos-memory",
  "name": "MindMemOS Memory",
  "description": "Recalls MindMemOS memories, reports trajectories to Memory and Skill, and bundles the MindMemOS CLI Skill.",
  "version": "0.2.0",
  "kind": "memory",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "cli": {
        "type": "string"
      },
      "topK": {
        "type": "integer",
        "minimum": 1
      },
      "multimodal": {
        "type": "boolean"
      },
      "tokenBudget": {
        "type": "integer",
        "minimum": 1
      },
      "addMode": {
        "type": "string",
        "enum": [
          "sync",
          "async"
        ]
      },
      "userId": {
        "type": "string"
      },
      "appId": {
        "type": "string"
      },
      "sessionId": {
        "type": "string"
      },
      "minQueryLength": {
        "type": "integer",
        "minimum": 1
      },
      "maxConversationMessages": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "skills": [
    "./dist/skills"
  ]
}
